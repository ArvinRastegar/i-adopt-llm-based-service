@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/HB/BPFOS>
    a 
        iop:Variable ;
    rdfs:label 
        "Percentage Branched Perfluorooctane sulfonic acid (BPFOS)" ;
    rdfs:comment 
        """Percentage Branched Perfluorooctane sulfonic acid in blood""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/129" ;
    iop:hasObjectOfInterest 
        _:b0 ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q5> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/VolumeFraction> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "condition: branched isomers" ;
             iop:constrains <https://www.wikidata.org/entity/Q902094> ;
        ] .

_:b0
    a 
        iop:Entity ,
        iop:AsymmetricSystem ;
    iop:hasDenominator 
        <https://www.wikidata.org/entity/Q7873> ;
    iop:hasNumerator 
        <https://www.wikidata.org/entity/Q902094> .

<https://www.wikidata.org/entity/Q5>
    a 
        iop:Entity ;
    rdfs:label 
        "person" .

<https://qudt.org/vocab/quantitykind/VolumeFraction>
    a 
        iop:Property ;
    rdfs:label 
        "volume fraction" .

<https://www.wikidata.org/entity/Q7873>
    a 
        iop:Entity ;
    rdfs:label 
        "blood" .

<https://www.wikidata.org/entity/Q902094>
    a 
        iop:Entity ;
    rdfs:label 
        "Perfluorooctane sulfonic acid" .
