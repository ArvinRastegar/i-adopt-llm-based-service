@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

ex:C23
    a 
        iop:Variable ;
    rdfs:label 
        "Cellular dose in vitro of nanomaterials (mass / cell)" ;
    rdfs:comment 
        """the mass of nanomaterial internalised into the cell over the duration of the experiment, mass per cell""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/29" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q967847> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/Mass> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "normalization: per cell" ;
             iop:constrains <https://qudt.org/vocab/quantitykind/Mass> ;
        ] .

<https://www.wikidata.org/entity/Q967847>
    a 
        iop:Entity ;
    rdfs:label 
        "nanomaterial" .

<https://qudt.org/vocab/quantitykind/Mass>
    a 
        iop:Property ;
    rdfs:label 
        "mass" .
