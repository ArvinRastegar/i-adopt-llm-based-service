@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/HB/DehpNail>
    a 
        iop:Variable ;
    rdfs:label 
        "Mass ratio of dehp in nail" ;
    rdfs:comment 
        """Mass ratio of dehp in nail, measured for a person.""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/126" ;
    iop:hasObjectOfInterest 
        _:b0 ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q5> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/MassFraction> .

_:b0
    a 
        iop:Entity ,
        iop:AsymmetricSystem ;
    iop:hasDenominator 
        <https://www.wikidata.org/entity/Q36864> ;
    iop:hasNumerator 
        <https://www.wikidata.org/entity/Q418492> .

<https://www.wikidata.org/entity/Q5>
    a 
        iop:Entity ;
    rdfs:label 
        "person" .

<https://qudt.org/vocab/quantitykind/MassFraction>
    a 
        iop:Property ;
    rdfs:label 
        "mass fraction" .

<https://www.wikidata.org/entity/Q36864>
    a 
        iop:Entity ;
    rdfs:label 
        "nail" .

<https://www.wikidata.org/entity/Q418492>
    a 
        iop:Entity ;
    rdfs:label 
        "diethylhexyl phthalate " .
