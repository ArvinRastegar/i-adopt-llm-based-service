@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .

ex:heartrate
    a 
        iop:Variable ;
    rdfs:label 
        "BPM Mean heart rate" ;
    rdfs:comment 
        """mean heart rate, beats per minute (ECG-derived)""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/105" ;
    iop:hasObjectOfInterest 
        <http://purl.bioontology.org/ontology/RCD/X76JX> ;
    iop:hasMatrix 
        <hhttps://www.wikidata.org/entity/Q5> ;
    iop:hasStatisticalModifier 
        <https://www.wikidata.org/entity/Q2796622> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/Count> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "normalization: per minute" ;
             iop:constrains <https://qudt.org/vocab/quantitykind/Count> ;
        ] .

<http://purl.bioontology.org/ontology/RCD/X76JX>
    a 
        iop:Entity ;
    rdfs:label 
        "heart beat" .

<hhttps://www.wikidata.org/entity/Q5>
    a 
        iop:Entity ;
    rdfs:label 
        "person" .

<https://www.wikidata.org/entity/Q2796622>
    a 
        iop:StatisticalModifier ;
    rdfs:label 
        "mean" .

<https://qudt.org/vocab/quantitykind/Count>
    a 
        iop:Property ;
    rdfs:label 
        "count" .
