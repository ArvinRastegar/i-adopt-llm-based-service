@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

ex:C21
    a 
        iop:Variable ;
    rdfs:label 
        "Resting systolic blood pressure" ;
    rdfs:comment 
        """Resting systolic blood pressure in millimeters of mercury (mmHg)""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/27" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q7873> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q215627> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/Pressure> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "locomotion state: resting" ;
             iop:constrains <https://www.wikidata.org/entity/Q215627> ;
        ] ,
        [ a iop:Constraint ;
             rdfs:label "process: systole" ;
             iop:constrains <https://qudt.org/vocab/quantitykind/Pressure> ;
        ] .

<https://www.wikidata.org/entity/Q7873>
    a 
        iop:Entity ;
    rdfs:label 
        "blood" .

<https://www.wikidata.org/entity/Q215627>
    a 
        iop:Entity ;
    rdfs:label 
        "person" .

<https://qudt.org/vocab/quantitykind/Pressure>
    a 
        iop:Property ;
    rdfs:label 
        "pressure" .
