@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

ex:C30
    a 
        iop:Variable ;
    rdfs:label 
        "Date of last PCR-test by certified laboratory" ;
    rdfs:comment 
        """date of last COVID-19 PCR test performed by a certified laboratory""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/36" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q104462307> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q5> ;
    iop:hasProperty 
        <https://www.wikidata.org/entity/Q205892> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "purpose: SARS-CoV2" ;
             iop:constrains <https://www.wikidata.org/entity/Q104462307> ;
        ] ,
        [ a iop:Constraint ;
             rdfs:label "agent: certified laboratory" ;
             iop:constrains <https://www.wikidata.org/entity/Q104462307> ;
        ] ,
        [ a iop:Constraint ;
             rdfs:label "event: latest" ;
             iop:constrains <https://www.wikidata.org/entity/Q104462307> ;
        ] .

<https://www.wikidata.org/entity/Q104462307>
    a 
        iop:Entity ;
    rdfs:label 
        "PCR-test" .

<https://www.wikidata.org/entity/Q5>
    a 
        iop:Entity ;
    rdfs:label 
        "person" .

<https://www.wikidata.org/entity/Q205892>
    a 
        iop:Property ;
    rdfs:label 
        "calendar date" .
