@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/Clinical/BMI>
    a 
        iop:Variable ;
    rdfs:label 
        "Body Mass Index" ;
    rdfs:comment 
        """Body mass index calculated by dividing body mass by height squared""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/107" ;
    iop:hasObjectOfInterest 
        _:b0 ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q5> ;
    iop:hasProperty 
        <https://www.wikidata.org/entity/Q1738991> .

_:b0
    a 
        iop:Entity ;
    rdfs:label 
        "body mass" .

<https://www.wikidata.org/entity/Q5>
    a 
        iop:Entity ;
    rdfs:label 
        "person" .

<https://www.wikidata.org/entity/Q1738991>
    a 
        iop:Property ;
    rdfs:label 
        "index" .
