@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix patt: <http://example.org/iadopt/pattern> .

ex:nitrCon
    a 
        iop:Variable ;
    rdfs:label 
        "Labile detrital nitrogen concentration in the seabed" ;
    rdfs:comment 
        """Labile detrital nitrogen concentration in the seabed in mmoleN/kg in sediment.""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/88" ;
    iop:hasObjectOfInterest 
        _:b0 ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q468469> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "source: detrital organic matter" ;
             iop:constrains <https://www.wikidata.org/entity/Q627> ;
        ] ,
        [ a iop:Constraint ;
             rdfs:label "state: labile" ;
             iop:constrains <https://www.wikidata.org/entity/Q627> ;
        ] .

_:b0
    a 
        iop:Entity ,
        iop:AsymmetricSystem ;
    iop:hasDenominator 
        <https://www.wikidata.org/entity/Q180184> ;
    iop:hasNumerator 
        <https://www.wikidata.org/entity/Q627> .

<https://www.wikidata.org/entity/Q468469>
    a 
        iop:Entity ;
    rdfs:label 
        "seabed" .

<https://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass>
    a 
        iop:Property ;
    rdfs:label 
        "amount of substance per mass" .

<https://www.wikidata.org/entity/Q180184>
    a 
        iop:Entity ;
    rdfs:label 
        "sediment" .

<https://www.wikidata.org/entity/Q627>
    a 
        iop:Entity ;
    rdfs:label 
        "nitrogen" .
