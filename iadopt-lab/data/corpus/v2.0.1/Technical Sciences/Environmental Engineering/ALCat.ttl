@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/iadopt/env/Alcat>
    a 
        iop:Variable ;
    rdfs:label 
        "Concentration of Al cations in water" ;
    rdfs:comment 
        """Concentration of Al cations in water""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/121" ;
    iop:hasObjectOfInterest 
        _:b0 ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/AmountOfSubstanceConcentration> .

_:b0
    a 
        iop:Entity ,
        iop:AsymmetricSystem ;
    iop:hasDenominator 
        <https://www.wikidata.org/entity/Q283> ;
    iop:hasNumerator 
        <https://www.wikidata.org/entity/Q27104698> .

<https://qudt.org/vocab/quantitykind/AmountOfSubstanceConcentration>
    a 
        iop:Property ;
    rdfs:label 
        "amount of substance concentration" .

<https://www.wikidata.org/entity/Q283>
    a 
        iop:Entity ;
    rdfs:label 
        "water" .

<https://www.wikidata.org/entity/Q27104698>
    a 
        iop:Entity ;
    rdfs:label 
        "aluminium cation" .
