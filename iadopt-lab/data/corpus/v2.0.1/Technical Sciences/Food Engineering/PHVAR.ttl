    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q40936> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q618355> ;
    iop:hasProperty 
        <https://www.wikidata.org/entity/Q1738991> .

<https://www.wikidata.org/entity/Q40936>
    a 
        iop:Entity ;
    rdfs:label 
        "pH" .

