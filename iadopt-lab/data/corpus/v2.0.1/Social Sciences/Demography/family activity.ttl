@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/iadopt/healthcare/familyactivity>
    a 
        iop:Variable ;
    rdfs:label 
        "Number of Hours of family activity per week" ;
    rdfs:comment 
        """Number of Hours of family activity per week""" ;    
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/110" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q61788146> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q5> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/Time> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "normalization: week" ;
             iop:constrains <https://qudt.org/vocab/quantitykind/Time> ;
        ] .

<https://www.wikidata.org/entity/Q61788146>
    a 
        iop:Entity ;
    rdfs:label 
        "family activity" .

<https://www.wikidata.org/entity/Q5>
    a 
        iop:Entity ;
    rdfs:label 
        "person" .

<https://qudt.org/vocab/quantitykind/Time>
    a 
        iop:Property ;
    rdfs:label 
        "time" .
