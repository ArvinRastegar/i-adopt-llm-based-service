@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/iadopt/CCA/primfunction>
    a
        iop:Variable ;
    rdfs:label
        "Primary function of building" ;
    rdfs:comment
        """Primary function of building""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/166" ;
    iop:hasObjectOfInterest
        <https://www.wikidata.org/entity/Q41176> ;
    iop:hasProperty
        <https://www.wikidata.org/entity/Q1724915> ;
    iop:hasConstraint
        [ a iop:Constraint ;
             rdfs:label "order: primary" ;
             iop:constrains <https://www.wikidata.org/entity/Q1724915> ;
        ] .

<https://www.wikidata.org/entity/Q41176>
    a
        iop:Entity ;
    rdfs:label
        "building" .

<https://www.wikidata.org/entity/Q1724915>
    a
        iop:Property ;
    rdfs:label
        "function" .
