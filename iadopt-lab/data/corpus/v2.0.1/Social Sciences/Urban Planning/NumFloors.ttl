@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/iadopt/ATM/irradiance>
    a 
        iop:Variable ;
    rdfs:label 
        "Number of floors above ground of building" ;
    rdfs:comment 
        """Number of floors above ground of building""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/165" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q831691> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q41176> ;
    iop:hasProperty 
        <http://qudt.org/vocab/quantitykind/Count> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "reference: above ground" ;
             iop:constrains <https://www.wikidata.org/entity/Q831691> ;
        ] .

<https://www.wikidata.org/entity/Q831691>
    a 
        iop:Entity ;
    rdfs:label 
        "storey" .

<https://www.wikidata.org/entity/Q41176>
    a 
        iop:Entity ;
    rdfs:label 
        "building" .

<http://qudt.org/vocab/quantitykind/Count>
    a 
        iop:Property ;
    rdfs:label 
        "count" .
