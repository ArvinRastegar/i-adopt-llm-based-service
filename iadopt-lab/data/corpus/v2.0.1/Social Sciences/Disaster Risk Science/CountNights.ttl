@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/iadopt/NS/SP/solarobs>
    a 
        iop:Variable ;
    rdfs:label 
        "Count of tropic nights" ;
    rdfs:comment 
        """Count of tropic nights, with min temperature > 20 ° Celsius in urban areas""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/172" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q575> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q702492> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/Count> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "min temperature: > 20 ° C" ;
             iop:constrains <https://www.wikidata.org/entity/Q575> ;
        ] .

<https://www.wikidata.org/entity/Q575>
    a 
        iop:Entity ;
    rdfs:label 
        "night" .

<https://www.wikidata.org/entity/Q702492>
    a 
        iop:Entity ;
    rdfs:label 
        "urban area" .

<https://qudt.org/vocab/quantitykind/Count>
    a 
        iop:Property ;
    rdfs:label 
        "count" .
