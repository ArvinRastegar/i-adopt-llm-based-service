@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/iadopt/CCA/primfunction>
    a 
        iop:Variable ;
    rdfs:label 
        "Social Vulnerability to pluvial floods of the residents" ;
    rdfs:comment 
        """Social Vulnerability to pluvial floods of the residents""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/167" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q581445> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q215627> ;
    iop:hasProperty 
        <https://www.wikidata.org/entity/Q1738991> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "role: resident" ;
             iop:constrains <https://www.wikidata.org/entity/Q215627> ;
        ] ,
        [ a iop:Constraint ;
             rdfs:label "cause: pluvial flood" ;
             iop:constrains <https://www.wikidata.org/entity/Q581445> ;
        ] .

<https://www.wikidata.org/entity/Q581445>
    a 
        iop:Entity ;
    rdfs:label 
        "social vulnerability" .

<https://www.wikidata.org/entity/Q215627>
    a 
        iop:Entity ;
    rdfs:label 
        "person" .

<https://www.wikidata.org/entity/Q1738991>
    a 
        iop:Property ;
    rdfs:label 
        "index" .
<http://example.org/iadopt/CCA/primfunction> <http://example.org/iadopt/issue> "https://github.com/mabablue/I-ADOPT-examples-playground/issues/167" .
