@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

ex:FloodRiskMobility
    a 
        iop:Variable ;
    rdfs:label 
        "Flood risk index related to mobility and accessibility of an urban area" ;
    rdfs:comment 
        """Flood risk index related to mobility and accessibility when streets around the houses are flooded""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/98" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q104493> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q702492> ;
    iop:hasProperty 
        <https://www.wikidata.org/entity/Q1738991> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "cause: pluvial flood to mobility and accessibility of an urban area" ;
             iop:constrains <https://www.wikidata.org/entity/Q104493> ;
        ] .

<https://www.wikidata.org/entity/Q104493>
    a 
        iop:Entity ;
    rdfs:label 
        "risk" .

<https://www.wikidata.org/entity/Q702492>
    a 
        iop:Entity ;
    rdfs:label 
        "urban area" .

<https://www.wikidata.org/entity/Q1738991>
    a 
        iop:Property ;
    rdfs:label 
        "index" .
