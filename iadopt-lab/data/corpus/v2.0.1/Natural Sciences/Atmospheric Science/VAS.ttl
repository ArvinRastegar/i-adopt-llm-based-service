@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/meteo/VAS>
    a 
        iop:Variable ;
    rdfs:label 
        "Northward Near-Surface Wind" ;
    rdfs:comment 
        """Northward Near-Surface Wind (v-component), measured in m s⁻¹""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/116" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q8094> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q8104> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/Velocity> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "part: near surface" ;
             iop:constrains <https://www.wikidata.org/entity/Q8104> ;
        ] ,
        [ a iop:Constraint ;
             rdfs:label "direction: northward" ;
             iop:constrains <https://qudt.org/vocab/quantitykind/Velocity> ;
        ] .

<https://www.wikidata.org/entity/Q8094>
    a 
        iop:Entity ;
    rdfs:label 
        "wind" .

<https://www.wikidata.org/entity/Q8104>
    a 
        iop:Entity ;
    rdfs:label 
        "atmosphere" .

<https://qudt.org/vocab/quantitykind/Velocity>
    a 
        iop:Property ;
    rdfs:label 
        "velocity" .
