@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

ex:C4
    a 
        iop:Variable ;
    rdfs:label 
        "Atmospheric boundary layer height defined by temperature inversion" ;
    rdfs:comment 
        """Atmospheric boundary layer height defined by temperature inversion, aboveground.""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/10" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q1757268> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q8104> ;
    iop:hasProperty 
        <https://www.wikidata.org/entity/Q208826> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "process: temperature inversion" ;
             iop:constrains <https://www.wikidata.org/entity/Q1757268> ;
        ] ,
        [ a iop:Constraint ;
             rdfs:label "reference: above ground" ;
             iop:constrains <https://www.wikidata.org/entity/Q208826> ;
        ] .

<https://www.wikidata.org/entity/Q1757268>
    a 
        iop:Entity ;
    rdfs:label 
        "atmospheric boundary layer" .

<https://www.wikidata.org/entity/Q8104>
    a 
        iop:Entity ;
    rdfs:label 
        "atmosphere" .

<https://www.wikidata.org/entity/Q208826>
    a 
        iop:Property ;
    rdfs:label 
        "height" .
