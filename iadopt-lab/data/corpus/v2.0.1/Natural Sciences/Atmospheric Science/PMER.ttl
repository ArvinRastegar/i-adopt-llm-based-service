@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/meteo/PMER>
    a 
        iop:Variable ;
    rdfs:label 
        "Mean sea level pressure" ;
    rdfs:comment 
        """Mean sea level pressure expressed in Pa""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/115" ;
  iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q7391292> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q8104> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/AtmosphericPressure> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "reference: mean sea level" ;
             iop:constrains <https://www.wikidata.org/entity/Q7391292> ;
        ] .

<https://www.wikidata.org/entity/Q7391292>
    a 
        iop:Entity ;
    rdfs:label 
        "air" .

<https://www.wikidata.org/entity/Q8104>
    a 
        iop:Entity ;
    rdfs:label 
        "atmosphere" .

<https://qudt.org/vocab/quantitykind/AtmosphericPressure>
    a 
        iop:Property ;
    rdfs:label 
        "atmospheric pressure" .
