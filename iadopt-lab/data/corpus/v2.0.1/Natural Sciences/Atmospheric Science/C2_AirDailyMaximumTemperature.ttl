@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

ex:C2
    a 
        iop:Variable ;
    rdfs:label 
        "Air daily maximum temperature at 1.7m" ;
    rdfs:comment 
        """Thermodynamic temperature of the air in a height of 1.7 meter aboveground, daily maximum in Celsium degrees.""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/8" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q7391292> ;
    iop:hasMatrix 
        <https://www.wikidata.org/entity/Q8104> ;
    iop:hasStatisticalModifier 
        <https://www.wikidata.org/entity/Q10578722> ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/ThermodynamicTemperature> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "reporting frequency: daily" ;
             iop:constrains <https://www.wikidata.org/entity/Q10578722> ;
        ] ,
        [ a iop:Constraint ;
             rdfs:label "reference: 1.7 m  above ground" ;
             iop:constrains <https://www.wikidata.org/entity/Q7391292> ;
        ] .

<https://www.wikidata.org/entity/Q7391292>
    a 
        iop:Entity ;
    rdfs:label 
        "air" .

<https://www.wikidata.org/entity/Q8104>
    a 
        iop:Entity ;
    rdfs:label 
        "atmosphere" .

<https://www.wikidata.org/entity/Q10578722>
    a 
        iop:StatisticalModifier ;
    rdfs:label 
        "maximum" .

<https://qudt.org/vocab/quantitykind/ThermodynamicTemperature>
    a 
        iop:Property ;
    rdfs:label 
        "thermodynamic temperature" .
