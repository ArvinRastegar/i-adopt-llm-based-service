@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <http://example.org/iadopt/challenge/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix patt: <http://example.org/iadopt/pattern> .

<http://example.org/CCA/SnowEquiv>
    a
        iop:Variable ;
    rdfs:label
        "Snow water equivalent" ;
    rdfs:comment
        """Snow Water Equivalent or Surface Snow Amount is the mass of water per unit area (kg/m²)""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/128" ;
   iop:hasObjectOfInterest 
        _:b0 ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/SurfaceDensity> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "state: solid" ;
             iop:constrains <https://www.wikidata.org/entity/Q283> ;
        ] ,
        [ a iop:Constraint ;
             rdfs:label "physical form: snow" ;
             iop:constrains <https://www.wikidata.org/entity/Q283> ;
        ] .

_:b0
    a 
        iop:Entity ,
        iop:AsymmetricSystem ;
    iop:hasDenominator 
        <https://www.wikidata.org/entity/Q11500> ;
    iop:hasNumerator 
        <https://www.wikidata.org/entity/Q283> .

<https://qudt.org/vocab/quantitykind/SurfaceDensity>
    a 
        iop:Property ;
    rdfs:label 
        "surface density" .

<https://www.wikidata.org/entity/Q11500>
    a 
        iop:Entity ;
    rdfs:label 
        "area" .

<https://www.wikidata.org/entity/Q283>
    a 
        iop:Entity ;
    rdfs:label 
        "water" .
