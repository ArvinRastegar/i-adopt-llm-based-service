@prefix uom: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .

<http://example.org/EnvScience/PotEvap>
    a 
        iop:Variable ;
    rdfs:label 
        "Potential evaporation" ;
    rdfs:comment 
        """Potential evaporation l m⁻² s⁻¹""" ;
    ex:issue "https://github.com/mabablue/I-ADOPT-examples-playground/issues/125" ;
    iop:hasObjectOfInterest 
        <https://www.wikidata.org/entity/Q190120> ;
    iop:hasMatrix 
        _:b0 ;
    iop:hasProperty 
        <https://qudt.org/vocab/quantitykind/VolumetricFlux> ;
    iop:hasConstraint 
        [ a iop:Constraint ;
             rdfs:label "condition: at non-limiting water supply" ;
             iop:constrains <https://www.wikidata.org/entity/Q190120> ;
        ] .

<https://www.wikidata.org/entity/Q190120>
    a 
        iop:Entity ;
    rdfs:label 
        "water vapour" .

_:b0
    a 
        iop:Entity ,
        iop:AsymmetricSystem ;
    iop:hasSource 
        <https://www.wikidata.org/entity/Q36133> ;
    iop:hasTarget 
        <https://www.wikidata.org/entity/Q8104> .

<https://qudt.org/vocab/quantitykind/VolumetricFlux>
    a 
        iop:Property ;
    rdfs:label 
        "volumetric flux" .

<https://www.wikidata.org/entity/Q36133>
    a 
        iop:Entity ;
    rdfs:label 
        "soil" .

<https://www.wikidata.org/entity/Q8104>
    a 
