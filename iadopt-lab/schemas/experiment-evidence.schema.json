{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iadopt-lab:schema:experiment-evidence:1.0",
  "title": "I-ADOPT Lab exported experiment evidence envelope",
  "description": "Closed lineage envelope for full immutable evidence. Exact raw provider bytes are exported as base64; PostgreSQL stores them as bytea. The record is validated by its versioned component contract before persistence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "campaign_id", "record_id", "record_sha256", "record"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"enum": ["campaign", "corpus", "run", "task", "attempt", "response", "validation", "prediction", "evaluation", "ranking", "cost", "authorization"]},
    "campaign_id": {"type": "string", "format": "uuid"},
    "record_id": {"type": "string", "minLength": 1},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "task_id": {"type": ["string", "null"], "format": "uuid"},
    "attempt_id": {"type": ["string", "null"], "format": "uuid"},
    "provider": {"enum": ["psnc", "openrouter", "mock", null]},
    "model_id": {"type": ["string", "null"]},
    "record": {"type": "object"},
    "raw_body_base64": {"type": ["string", "null"], "contentEncoding": "base64"},
    "raw_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "exporter_version": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "attempt"}}}, "then": {"required": ["task_id", "provider", "model_id"], "properties": {"record": {"required": ["attempt_number", "messages", "prompt", "request_body"], "properties": {"attempt_number": {"type": "integer", "minimum": 1, "maximum": 3}, "messages": {"type": "array", "minItems": 1}, "prompt": {"type": "string"}, "request_body": {"type": "object"}}}}}},
    {"if": {"properties": {"kind": {"const": "response"}}}, "then": {"required": ["attempt_id", "raw_body_base64", "raw_sha256"], "properties": {"record": {"required": ["delivery"], "properties": {"delivery": {"enum": ["not_dispatched", "response_received", "rejected", "ambiguous_delivery"]}}}}}},
    {"if": {"properties": {"kind": {"const": "validation"}}}, "then": {"required": ["attempt_id"], "properties": {"record": {"required": ["valid", "errors"], "properties": {"valid": {"type": "boolean"}, "errors": {"type": "array"}}}}}},
    {"if": {"properties": {"kind": {"const": "evaluation"}}}, "then": {"required": ["task_id"], "properties": {"record": {"required": ["scorer_version", "gold_hash", "prediction_hash", "exact", "close", "result_hash"], "properties": {"gold_hash": {"$ref": "#/$defs/sha256"}, "prediction_hash": {"$ref": "#/$defs/sha256"}, "result_hash": {"$ref": "#/$defs/sha256"}}}}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
